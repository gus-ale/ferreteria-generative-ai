APP_ENV=development
DEBUG=false
AUTO_CREATE_TABLES=true
SEED_DEMO_DATA=true

# Local development. Docker Compose overrides this value for MySQL.
DATABASE_URL=sqlite+aiosqlite:///./ferreteria_genai.db

# Used by Docker Compose to create and connect to MySQL.
DB_PASSWORD=change-this-database-password
MYSQL_ROOT_PASSWORD=change-this-root-password

# demo works offline. Change to openai to use the real API.
AI_PROVIDER=demo
EMBEDDING_PROVIDER=local
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=2
MAX_AGENT_TURNS=4

# Replace this value before exposing write endpoints.
ADMIN_API_KEY=development-admin-key-change-me
CORS_ORIGINS=["http://localhost:4200","http://localhost:3000"]
LOG_LEVEL=INFO
